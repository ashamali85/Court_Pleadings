generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
}

/// What a client may attach. The order here is the order the form shows.
enum AttachmentKind {
  LEASE
  PLAINTIFF_ID
  DEFENDANT_ID
  COMPANY_DEED
  TRADE_LICENCE
  HEIRS_INVENTORY
  OTHER
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  GENERATED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(CLIENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests    CaseRequest[] @relation("ClientRequests")
  documents   Document[]    @relation("GeneratedBy")
  attachments Attachment[]  @relation("UploadedAttachments")
  auditLogs  AuditLog[]
  siteTexts  SiteText[]
}

/// One row per document type the office offers. The .docx template itself is
/// stored here so a new version can be uploaded without a redeploy.
model CaseTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  nameAr      String
  descriptionAr String?
  version     Int      @default(1)
  active      Boolean  @default(true)
  docx        Bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests CaseRequest[]
}

model CaseRequest {
  id          String        @id @default(cuid())
  reference   String        @unique
  templateKey String
  clientId    String
  status      RequestStatus @default(SUBMITTED)
  /// values submitted by the client
  data        Json
  /// lawyer's corrections, merged over `data` at generation time
  reviewedData Json?
  clientNote  String?
  lawyerNote  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client    User         @relation("ClientRequests", fields: [clientId], references: [id])
  template    CaseTemplate @relation(fields: [templateKey], references: [key])
  documents   Document[]
  attachments Attachment[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

model Document {
  id            String   @id @default(cuid())
  requestId     String
  version       Int
  filename      String
  mimeType      String   @default("application/vnd.openxmlformats-officedocument.wordprocessingml.document")
  bytes         Bytes
  generatedById String
  createdAt     DateTime @default(now())

  request     CaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  generatedBy User        @relation("GeneratedBy", fields: [generatedById], references: [id])

  @@unique([requestId, version])
}

/// A file the client attached to a request. The bytes live in a private
/// Vercel Blob store, never in Postgres — a scan of a lease is far larger than
/// the generated .docx and would bloat the database and its backups.
///
/// `requestId` is null while the client is still filling the form: the upload
/// happens as soon as a file is chosen, so it is held against `draftKey` until
/// the request exists and then adopted by it. A row with neither is orphaned
/// and safe to sweep.
model Attachment {
  id           String         @id @default(cuid())
  requestId    String?
  /// groups a draft's uploads before the request is created
  draftKey     String?
  kind         AttachmentKind
  filename     String
  mimeType     String
  size         Int
  /// pathname inside the private blob store; not a public URL
  blobPath     String         @unique
  uploadedById String
  createdAt    DateTime       @default(now())

  request    CaseRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation("UploadedAttachments", fields: [uploadedById], references: [id])

  /// one file per kind per request — replacing simply deletes the old row
  @@unique([requestId, kind])
  @@index([draftKey])
  @@index([uploadedById, createdAt])
}

/// Every user-visible string in the app. A row exists only when the admin has
/// overridden the built-in default (lib/content/defaults.ts), so deleting a row
/// restores the original wording.
model SiteText {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])
}

/// Sequential human-facing reference numbers, e.g. SR-2026-0001
model Counter {
  id    String @id @default(cuid())
  key   String @unique
  value Int    @default(0)
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  meta     Json?
  ip       String?
  at       DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId, at])
  @@index([at])
}
