# Neon PostgreSQL — pooled URL for the app, non-pooled for the CLI
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/sahifa?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/sahifa?sslmode=require"

# Session signing key — at least 32 characters. Generate it yourself:
#   openssl rand -base64 48
JWT_SECRET=""

# Seed accounts (only read by prisma/seed.ts; set your own values)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="علي محمود العريان"
SEED_CLIENT_EMAIL=""
SEED_CLIENT_PASSWORD=""
SEED_CLIENT_NAME=""

# Email notifications (optional — the app runs fine without them)
RESEND_API_KEY=""
MAIL_FROM="Sahifa <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=""
APP_URL="http://localhost:3000"
